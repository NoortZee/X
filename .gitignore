# --- секреты: локальный конфиг и любые его копии ---------------------------
# install.sh делает config.yaml.broken.<дата>, ручные бэкапы — <имя>.bak.<время>.
# В конфиге лежат bot_token и chat_id, поэтому игнорируем всё производное.
config.yaml
config.yaml.*
*.local

# --- сборка Rust ----------------------------------------------------------
/target/

# --- рантайм-артефакты ----------------------------------------------------
# replays/ намеренно НЕ игнорируется: записи прогонов (md + кадр) хранятся в
# репозитории. Игнорируются только старые логи и диагностические дампы.
/logs/
/diag/
nohup.out
*.log

# --- кэши инструментов и Python -------------------------------------------
/.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.aider*
.mimocode/

# --- редакторы и ОС -------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- временные файлы ------------------------------------------------------
*.tmp
*.orig
*.rej
*.part
